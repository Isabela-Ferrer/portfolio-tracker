{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dream-tracker",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "exec /Library/Frameworks/Python.framework/Versions/3.11/bin/python3 -u -m uvicorn main:app --host 127.0.0.1 --port \"${PORT:-8000}\""
      ],
      "port": 8000,
      "autoPort": true
    }
  ]
}
