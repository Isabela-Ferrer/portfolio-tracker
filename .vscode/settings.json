{
  // Use the project's own virtualenv. Everything in requirements-dev.txt is
  // installed there, including pytest.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Turn on the Testing panel (the flask icon in the left sidebar) and tell it
  // this project uses pytest rather than unittest.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // Re-scan for new tests whenever a test file is saved.
  "python.testing.autoTestDiscoverOnSaveEnabled": true
}
