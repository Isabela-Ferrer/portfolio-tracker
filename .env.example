# Required: weekly bullets and the per-company briefs
OPENAI_API_KEY=

# Where the digest goes. Required for sending, whichever transport you use.
DIGEST_EMAIL=

# Transport 1: Gmail over SMTP. Simplest option, and it sends from your own
# address so there is no domain to verify. SMTP_PASSWORD must be a Google App
# Password (16 characters, needs 2 step verification on), not your normal one:
# https://myaccount.google.com/apppasswords
# Note that Workspace admins, including many universities, can disable app
# passwords. If yours is blocked, use a personal Gmail or Resend instead.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Transport 2: Resend. Used only when SMTP_USER/SMTP_PASSWORD are not set.
RESEND_API_KEY=

# Sender address. Defaults to SMTP_USER for Gmail, or Resend's shared sender.
DIGEST_FROM=

# Without any transport the digest still renders at /api/digest/preview, it
# just records itself as skipped instead of sending.

# Used for the dashboard links inside the digest
APP_BASE_URL=http://localhost:8000

# Optional: YouTube Data API v3. Without it the youtube fetcher returns nothing
# and every other fetcher carries on unaffected.
YOUTUBE_API_KEY=

# Schedule overrides. weekday(): Monday is 0, Sunday is 6.
ENABLE_SCHEDULER=1
SCHEDULE_TZ=America/New_York
REFRESH_DAY=6
REFRESH_HOUR=23
DIGEST_DAY=0
DIGEST_HOUR=8
