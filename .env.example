# Required: weekly bullets and the per-company briefs
OPENAI_API_KEY=

# Digest email (Resend free tier). Without these the digest still renders at
# /api/digest/preview, it just records itself as skipped instead of sending.
RESEND_API_KEY=
DIGEST_EMAIL=
DIGEST_FROM=Dream Tracker <onboarding@resend.dev>

# Used for the dashboard links inside the digest
APP_BASE_URL=http://localhost:8000

# Optional: YouTube Data API v3. Without it the youtube fetcher returns nothing
# and every other fetcher carries on unaffected.
YOUTUBE_API_KEY=

# Schedule overrides. weekday(): Monday is 0, Sunday is 6.
ENABLE_SCHEDULER=1
SCHEDULE_TZ=America/New_York
REFRESH_DAY=6
REFRESH_HOUR=23
DIGEST_DAY=0
DIGEST_HOUR=8
